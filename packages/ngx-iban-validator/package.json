{
  "name": "ngx-iban-validator",
  "version": "1.2.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKaDiZZ/ngx-iban-validator.git"
  },
  "bugs": {
    "url": "https://github.com/SKaDiZZ/ngx-iban-validator/issues"
  },
  "author": {
    "name": "Samir Kahvedzic",
    "email": "akirapowered@gmail.com",
    "url": "https://samirkahvedzic.dev"
  },
  "description": "IBAN Validator for your web application forms (Angular, React, Vue, ...), comes without any dependencies and can be used as a standalone function in any JS project. It can perform format, digit and length IBAN validations. Currently 111 countries are supported.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist/",
    "build": "pnpm clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/write-dist-package-json.mjs",
    "watch": "node scripts/write-dist-package-json.mjs && tsc -p tsconfig.json --watch",
    "dev": "pnpm watch",
    "test": "jest",
    "test:dist": "node scripts/smoke-test-dist.cjs",
    "fix": "pnpm run format && pnpm run lint",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "check:iban": "node ../../scripts/check-iban-structure.js",
    "update:iban": "node ../../scripts/check-iban-structure.js --update",
    "preinstall": "npx only-allow pnpm",
    "release": "pnpm publish --no-git-checks --access public"
  },
  "keywords": [
    "ngx",
    "iban",
    "validator",
    "iban-validator",
    "angular",
    "angularjs",
    "react",
    "vue",
    "vuejs",
    "forms",
    "input"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.5",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  }
}
